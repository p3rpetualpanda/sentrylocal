        },
        {
          "ruleId": "sql-injection (CWE-89)",
          "level": "error",
          "message": {
            "text": "Potential SQL injection vulnerability detected."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures\\test_vulnerable_code.py"
                },
                "region": {
