            "text": "Use of eval() is dangerous and should be avoided."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures\\test_vulnerable.py"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "eval-use (CWE-94)",
          "level": "error",
