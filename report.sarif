          ]
        },
        {
          "ruleId": "os-system-use (CWE-78)",
          "level": "warning",
          "message": {
            "text": "Use of os.system() is dangerous and can lead to command injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures\\test_secure_code.py"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ]
        },
        {
          "ruleId": "eval-use (CWE-94)",
          "level": "error",
