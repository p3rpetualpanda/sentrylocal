                }
              }
            }
          ]
        },
        {
          "ruleId": "subprocess-shell (CWE-78)",
          "level": "error",
          "message": {
            "text": "subprocess with shell=True is vulnerable to command injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures\\test_new_rules.py"
                },
                "region": {
                  "startLine": 9
                }
              }
            }
          ]
        },
        {
          "ruleId": "weak-hash (CWE-328)",
          "level": "warning",
          "message": {
            "text": "MD5/SHA1 are not suitable for security purposes. Use SHA-256 or better."
          },
          "locations": [
